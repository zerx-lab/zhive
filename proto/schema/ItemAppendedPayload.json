      "description": "Lifecycle of a [`PlanStep`].",
      "oneOf": [
        {
          "description": "Not yet started.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "In progress.",
          "type": "string",
          "enum": [
            "inProgress"
          ]
        },
        {
          "description": "Done.",
