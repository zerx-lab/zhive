          "type": "string",
          "enum": [
            "in_progress"
          ]
        },
        {
          "description": "Finished successfully.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "Errored out.",
          "type": "string",
          "enum": [
            "failed"
          ]
