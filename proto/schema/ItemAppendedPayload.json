          "description": "File created.",
          "type": "string",
          "enum": [
            "create"
          ]
        },
        {
          "description": "Existing file modified.",
          "type": "string",
          "enum": [
            "update"
          ]
        },
        {
          "description": "File deleted.",
          "type": "string",
          "enum": [
