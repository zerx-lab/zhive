              "type": "string",
              "enum": [
                "content"
              ]
            }
          }
        },
        {
          "description": "File diff produced by the tool call.",
          "type": "object",
          "required": [
            "new_text",
            "path",
            "type"
          ],
          "properties": {
            "new_text": {
              "description": "Post-edit text.",
              "type": "string"
            },
            "old_text": {
              "description": "Pre-edit text; absent for created files.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Affected path.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "diff"
              ]
            }
          }
        },
        {
          "description": "Reference to an embedded terminal.",
          "type": "object",
          "required": [
            "terminal_id",
            "type"
          ],
          "properties": {
            "terminal_id": {
              "description": "Engine-issued terminal handle.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "terminal"
              ]
            }
          }
        }
      ]
    },
    "NoticeLevel": {
      "description": "Severity of an [`Item::SystemNotice`].",
      "oneOf": [
        {
          "description": "Informational.",
          "type": "string",
          "enum": [
            "info"
          ]
        },
        {
          "description": "Warning; the engine kept running.",
          "type": "string",
          "enum": [
            "warn"
          ]
        },
        {
          "description": "Recoverable error surfaced to the transcript.",
          "type": "string",
          "enum": [
            "error"
          ]
        }
      ]
    },
    "PatchApplyStatus": {
      "description": "Patch apply outcome for [`Item::FileEdit`].",
      "oneOf": [
        {
          "description": "Patch built but not yet applied.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "All hunks applied cleanly.",
          "type": "string",
          "enum": [
            "applied"
          ]
        },
        {
          "description": "At least one hunk rejected.",
          "type": "string",
          "enum": [
            "failed"
          ]
        }
      ]
    },
    "PatchChangeKind": {
      "description": "Kind of [`FileUpdateChange`] applied to a file.",
