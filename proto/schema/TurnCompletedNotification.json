    "ResourceContents": {
      "description": "Embedded resource payload: text or binary, both URI-addressed.\n\nStrong-typed replacement for the previous `resource: Value`. Mirrors ACP `EmbeddedResourceResource` (an untagged text/blob choice) but uses an internal `type` tag so the zhive wire form is self-describing and the schema is stable. The `_meta` ACP extension slot is intentionally dropped (zhive does not consume it).\n\n# Examples\n\n``` use zhive_proto::domain::ResourceContents; let text = ResourceContents::Text { uri: \"file:///foo.txt\".into(), text: \"hello\".into(), mime_type: Some(\"text/plain\".into()), }; let v = serde_json::to_value(&text).unwrap(); assert_eq!(v[\"type\"], \"text\"); assert_eq!(v[\"uri\"], \"file:///foo.txt\"); let back: ResourceContents = serde_json::from_value(v).unwrap(); assert_eq!(back, text); ```",
      "oneOf": [
        {
          "description": "UTF-8 text resource contents.",
          "type": "object",
          "required": [
            "text",
            "type",
            "uri"
          ],
          "properties": {
            "mime_type": {
              "description": "Optional MIME type hint.\n\nIntentionally kept as an `Option<String>` rather than a typed enum because MIME types are an open set.",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "Decoded text body.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "uri": {
              "description": "Resource URI (e.g. `file:///path`).",
              "type": "string"
            }
          }
        },
        {
          "description": "Base64-encoded binary resource contents.",
          "type": "object",
          "required": [
            "blob",
            "type",
            "uri"
          ],
          "properties": {
            "blob": {
              "description": "Base64-encoded binary body.",
              "type": "string"
            },
            "mime_type": {
              "description": "Optional MIME type hint.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "blob"
              ]
            },
            "uri": {
              "description": "Resource URI.",
              "type": "string"
            }
          }
        }
      ]
    },
    "ToolCallLocation": {
      "description": "File / line hint surfaced to UI alongside a tool call.",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "line": {
          "description": "Optional line number (1-based).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "path": {
          "description": "File path.",
          "type": "string"
        }
      }
    },
    "ToolCallStatus": {
      "description": "Lifecycle of a tool call (mirrors ACP `ToolCallStatus`).",
      "oneOf": [
        {
          "description": "Queued, not yet dispatched.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Dispatched and running.",
          "type": "string",
          "enum": [
            "in_progress"
          ]
        },
        {
          "description": "Finished successfully.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "Errored out.",
          "type": "string",
          "enum": [
            "failed"
          ]
        }
      ]
    },
    "ToolKind": {
      "description": "Coarse tool classification (mirrors ACP `ToolKind`).",
      "oneOf": [
        {
          "description": "Read-only file or resource access.",
          "type": "string",
          "enum": [
            "read"
          ]
        },
        {
          "description": "Modify a file or resource in place.",
          "type": "string",
          "enum": [
            "edit"
          ]
        },
        {
          "description": "Delete a file or resource.",
          "type": "string",
          "enum": [
            "delete"
          ]
        },
        {
          "description": "Move or rename a file or resource.",
          "type": "string",
          "enum": [
            "move"
          ]
        },
        {
          "description": "Search a corpus.",
          "type": "string",
          "enum": [
            "search"
          ]
        },
        {
          "description": "Execute a shell command or script.",
          "type": "string",
          "enum": [
            "execute"
          ]
        },
        {
          "description": "Internal reasoning (no side effects).",
          "type": "string",
          "enum": [
            "think"
          ]
        },
        {
          "description": "Fetch a remote resource.",
          "type": "string",
          "enum": [
            "fetch"
          ]
        },
        {
          "description": "Switch the agent mode.",
          "type": "string",
          "enum": [
            "switch_mode"
          ]
        },
        {
          "description": "Anything else.",
          "type": "string",
          "enum": [
            "other"
          ]
        }
      ]
    },
    "Turn": {
      "description": "One user-input-to-final-answer cycle within a [`Thread`].\n\nFor MCP, the bridge synthesises a turn boundary around each `tools/call` sequence by listening to the [`TurnStartedNotification`] / [`TurnCompletedNotification`] notifications emitted by the engine.",
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "completedAt": {
          "description": "Unix timestamp in seconds when the turn ended.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "durationMs": {
          "description": "`completed_at - started_at`, expressed in milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "error": {
          "description": "Failure details; populated only when `status == Failed`.",
          "anyOf": [
            {
              "$ref": "#/definitions/TurnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Stable turn id, see [`TurnId`].",
          "type": "string"
        },
        "items": {
          "description": "Ordered, append-only item list.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "itemsView": {
          "description": "Whether `items` is fully populated, summarised, or unloaded.",
          "default": "full",
          "allOf": [
            {
              "$ref": "#/definitions/TurnItemsView"
            }
          ]
        },
        "startedAt": {
          "description": "Unix timestamp in seconds when the turn started.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "description": "Lifecycle status of the turn.",
          "allOf": [
            {
              "$ref": "#/definitions/TurnStatus"
            }
          ]
        }
      }
    },
    "TurnError": {
      "description": "Failure details attached to a [`Turn`] with `status == Failed`.",
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "additionalDetails": {
          "description": "Free-form diagnostic payload (provider response, exit code, etc.).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Short human-readable summary of the failure.",
          "type": "string"
        }
      }
    },
    "TurnItemsView": {
      "description": "Whether [`Turn::items`] has been loaded from the JSONL rollout.",
      "oneOf": [
        {
          "description": "Items not yet read from persistence; the field is intentionally empty.",
          "type": "string",
          "enum": [
            "notLoaded"
          ]
        },
        {
          "description": "Items collapsed to a single summary entry (history compaction).",
          "type": "string",
          "enum": [
            "summary"
          ]
        },
        {
          "description": "Fully loaded items.",
          "type": "string",
          "enum": [
            "full"
          ]
        }
      ]
    },
    "TurnStatus": {
      "description": "Lifecycle state of a [`Turn`].",
      "oneOf": [
        {
          "description": "Active; never appears in `turn/completed` notifications.",
          "type": "string",
          "enum": [
            "inProgress"
          ]
        },
        {
          "description": "Reached a final agent message without errors.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "Cancelled by `session/cancel` or user abort.",
          "type": "string",
          "enum": [
            "interrupted"
          ]
        },
        {
          "description": "Engine or provider raised a fatal error.",
          "type": "string",
          "enum": [
            "failed"
          ]
        }
      ]
    }
  }
}