            "new_text",
            "path"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "diff"
              ]
            },
            "new_text": {
              "description": "Post-edit text.",
              "type": "string"
            },
            "old_text": {
              "description": "Pre-edit text; absent for created files.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Affected file.",
              "type": "string"
            }
          }
        },
        {
          "description": "Embedded terminal handle referenced by the UI.",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "terminal_id"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "terminal"
              ]
            },
            "terminal_id": {
              "description": "Opaque terminal handle issued by the engine.",
              "type": "string"
            }
          }
        },
        {
          "description": "Agent-authored plan step list.",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "steps"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "plan"
              ]
            },
            "steps": {
              "description": "Ordered steps.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PlanStep"
              }
            }
          }
        },
        {
          "description": "Refreshed list of slash commands or callable tools.",
          "type": "object",
          "required": [
            "commands",
            "id",
            "itemKind"
          ],
          "properties": {
            "commands": {
              "description": "Currently advertised commands.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/AvailableCommand"
              }
            },
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "available_commands"
              ]
            }
          }
        },
        {
          "description": "Mode switch (e.g. plan mode toggle).",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "mode_id"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "mode_change"
              ]
            },
            "mode_id": {
              "description": "New mode identifier.",
              "type": "string"
            }
