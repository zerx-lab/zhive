          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "context_compaction"
              ]
            }
          }
        },
        {
          "description": "Engine-emitted notice (info, warning, error) surfaced into the transcript.",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "level",
            "message"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
