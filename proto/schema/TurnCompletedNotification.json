{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnCompletedNotification",
  "description": "Bridge-synthesised `turn/completed` payload carrying the final [`Turn`] snapshot.\n\nThe final turn status is one of `Completed`, `Interrupted`, or `Failed`. This type is produced **by the bridge**, not by the engine directly.\n\n> **Disambiguation**: the engine itself emits > [`crate::events::TurnCompletedPayload`] (`{threadId, turnId}`) on the > `events/turn_completed` wire method. Bridges reframe that leaner payload as > a `TurnCompletedNotification` with the full `Turn` embedded. The two types > coexist intentionally.",
  "type": "object",
  "required": [
    "threadId",
    "turn"
  ],
  "properties": {
    "threadId": {
      "description": "Thread the turn belongs to.",
      "type": "string"
    },
    "turn": {
      "description": "Final turn snapshot; `status` is one of `Completed` / `Interrupted` / `Failed`.",
      "allOf": [
        {
          "$ref": "#/definitions/Turn"
        }
      ]
    }
  },
  "definitions": {
    "AvailableCommand": {
      "description": "Advertised slash command or callable tool.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "description": "Short human-readable description.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Command name (e.g. `commit`, `pr`).",
          "type": "string"
        }
      }
    },
    "CommandExecutionStatus": {
      "description": "Lifecycle of a [`Item::CommandExecution`].",
      "oneOf": [
        {
          "description": "Spawned, still running.",
          "type": "string",
          "enum": [
            "in_progress"
          ]
        },
        {
          "description": "Exited with status 0.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "Exited non-zero or killed.",
          "type": "string",
          "enum": [
            "failed"
          ]
        }
      ]
    },
    "FileUpdateChange": {
      "description": "One file's change within a [`Item::FileEdit`].",
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "description": "Kind of change applied.",
          "allOf": [
            {
              "$ref": "#/definitions/PatchChangeKind"
            }
          ]
        },
        "newText": {
          "description": "Post-edit text; absent for deleted files.",
          "type": [
            "string",
            "null"
          ]
        },
        "oldText": {
          "description": "Pre-edit text; absent for created files.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Affected path.",
          "type": "string"
        }
      }
    },
    "Item": {
      "description": "Leaf content primitive of a [`Turn`]; 14 variants covering all observable events.\n\n`#[non_exhaustive]` lets the schema evolve without breaking downstream match arms. Bridge crates must downgrade unknown wire variants to [`Item::SystemNotice`] with [`NoticeLevel::Warn`] rather than panic.\n\nThe discriminator is `itemKind` (not `kind`) so that the [`Item::ToolCall::kind`] inner field can keep its ACP-aligned name; serde disallows a tag and a variant field sharing one name.",
      "oneOf": [
        {
          "description": "Direct user input.",
          "type": "object",
          "required": [
            "content",
            "id",
            "itemKind"
          ],
          "properties": {
            "content": {
              "description": "Multi-part content (text / image / audio / resource).",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ItemContent"
              }
            },
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "user_message"
              ]
            }
          }
        },
        {
          "description": "Final or interim assistant message.",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "text"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "agent_message"
              ]
            },
            "text": {
              "description": "Plain-text body.",
              "type": "string"
            }
          }
        },
        {
          "description": "Streaming thought chunk surfaced by the model.",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "text"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "agent_thought"
              ]
            },
            "text": {
              "description": "Plain-text body.",
              "type": "string"
            }
          }
        },
        {
          "description": "Structured reasoning trace (codex-only; ACP bridges write `AgentThought`).",
          "type": "object",
          "required": [
            "id",
            "itemKind"
          ],
          "properties": {
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "reasoning"
              ]
            },
            "summary": {
              "description": "Ordered summary fragments.",
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "description": "Tool call dispatched by the agent (provider or extension tools).",
          "type": "object",
          "required": [
            "id",
            "itemKind",
            "name"
          ],
          "properties": {
            "content": {
              "description": "Tool call output / progress content.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ItemToolCallContent"
              }
            },
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "tool_call"
              ]
            },
            "kind": {
              "description": "Coarse classification, useful for UI grouping.",
              "default": "other",
              "allOf": [
                {
                  "$ref": "#/definitions/ToolKind"
                }
              ]
            },
            "locations": {
              "description": "File / location hints surfaced to UI.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ToolCallLocation"
              }
            },
            "name": {
              "description": "Tool name (e.g. `read_file`, `bash`).",
              "type": "string"
            },
            "provider_tool_call_id": {
              "description": "Provider-assigned tool call id (e.g. `toolu_01...` from Anthropic).\n\nPreserved from the [`StreamPart::ToolCall`] or `ToolInputStart` frame so the engine can round-trip it back in `Message::Tool` `tool_call_id` without minting a synthetic replacement.\n\n`None` for items that pre-date this field or originate outside the provider stream (e.g. synthetic items in tests).",
              "type": [
                "string",
                "null"
              ]
            },
            "raw_input": {
              "description": "Raw JSON arguments handed to the tool.\n\nIntentionally untyped: tool argument schemas are tool-defined."
            },
            "raw_output": {
              "description": "Raw JSON output returned by the tool.\n\nIntentionally untyped: tool output is tool-defined free-form JSON."
            },
            "status": {
              "description": "Tool call lifecycle status.",
              "default": "pending",
              "allOf": [
                {
                  "$ref": "#/definitions/ToolCallStatus"
                }
              ]
            }
          }
        },
        {
          "description": "Shell command execution.",
          "type": "object",
          "required": [
            "command",
            "cwd",
            "id",
            "itemKind",
            "status"
          ],
          "properties": {
            "aggregated_output": {
              "description": "Merged stdout + stderr capture.",
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "description": "Command line as provided to the shell.",
              "type": "string"
            },
            "cwd": {
              "description": "Working directory the command ran in.",
              "type": "string"
            },
            "duration_ms": {
              "description": "Wall-clock duration in milliseconds.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "exit_code": {
              "description": "Process exit code, populated when complete.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "id": {
              "description": "Per-turn item id.",
              "type": "string"
            },
            "itemKind": {
              "type": "string",
              "enum": [
                "command_execution"
              ]
            },
            "status": {
              "description": "Command lifecycle status.",
              "allOf": [
                {
                  "$ref": "#/definitions/CommandExecutionStatus"
                }
              ]
            }
          }
        },
        {
          "description": "File edit applied as a multi-file patch.",
          "type": "object",
          "required": [
            "changes",
            "id",
            "itemKind",
            "status"
          ],
          "properties": {
            "changes": {
              "description": "One entry per file touched.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/FileUpdateChange"
              }
            },
